# Email Triage Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# Email accounts the agent will scan
# ============================================================
# These are referenced inside .claude/agents/email-triage.md
# via the {{INBOX_*}} placeholders.

INBOX_PRIMARY="info@yourhotel.com"
INBOX_BOOKINGS="bookings@yourhotel.com"
INBOX_RENTALS="rentals@yourhotel.com"

# ============================================================
# Email provider CLI
# ============================================================
# The agent shells out to a command-line wrapper that can
# switch between accounts and read/list messages.
# Reference setup uses Google Workspace CLI (`gws`).

EMAIL_CLI="gws gmail"

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# The agent uses these tools to verify booking claims and
# append notes to reservations. Replace with whatever your
# PMS exposes.

PMS_LOOKUP_TOOL="tools/lookup_guest.py"
PMS_NOTES_TOOL="tools/cloudbeds_notes.py"

# Cloudbeds reference values (only needed if you use the
# Cloudbeds PMS for the lookup/notes tools above):
# CLOUDBEDS_CLIENT_ID=""
# CLOUDBEDS_CLIENT_SECRET=""
# CLOUDBEDS_ACCESS_TOKEN=""
# CLOUDBEDS_REFRESH_TOKEN=""
